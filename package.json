{
  "name": "spatial-mapping-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first authoring and viewing tools for Spatial Artefacts.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev:mapper": "pnpm --filter @electronic-artefacts/spatial-mapping-studio dev",
    "dev:demo": "pnpm --filter @electronic-artefacts/demo-vanilla dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:e2e": "playwright test",
    "benchmark": "pnpm --filter @electronic-artefacts/spatial-project-core build && node scripts/benchmark.mjs",
    "benchmark:browser": "node scripts/generate-browser-benchmarks.mjs && playwright test --config playwright.benchmark.config.ts",
    "benchmark:browser:full": "BENCHMARK_FULL=1 pnpm benchmark:browser",
    "benchmark:browser:dev": "BENCHMARK_SERVER=dev pnpm benchmark:browser",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "validate": "pnpm lint && pnpm format:check && pnpm test && pnpm build",
    "postinstall": "pnpm --filter @electronic-artefacts/shared build && pnpm --filter @electronic-artefacts/spatial-artefact-schema build && pnpm --filter @electronic-artefacts/spatial-viewer build"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.50.1",
    "@types/node": "^22.10.2",
    "@types/three": "^0.172.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
